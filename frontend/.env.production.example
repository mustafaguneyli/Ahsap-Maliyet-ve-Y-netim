# Firebase Hosting / production build. localhost yok.
# Cloud Run API adresi:
VITE_API_URL=https://YOUR-CLOUD-RUN-URL
# Hosting kök veya maliyet.zirveahsap... subdomain:
VITE_BASE=/
# Mevcut path deploy (zirveahsapdekorasyon.com/maliyet):
# VITE_BASE=/maliyet/
# Firebase Web SDK (client; secret değil). Auth Email/Password için gerekli.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zirve-ahsap.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zirve-ahsap
VITE_FIREBASE_STORAGE_BUCKET=zirve-ahsap.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
