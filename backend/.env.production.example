NODE_ENV=production
PORT=8080
# Cutover sonrası runtime. Rollback: DATA_STORE=postgres + DATABASE_URL
DATA_STORE=firestore
FIREBASE_PROJECT_ID=zirve-ahsap
FIREBASE_REQUIRED=true
FIREBASE_USE_ADC=true
# JSON dosyası image'a koyulmaz. Cloud Run service account / ADC.

FRONTEND_ORIGINS=https://zirve-ahsap.web.app,https://zirve-ahsap.firebaseapp.com,https://maliyet.zirveahsap.com

# Rollback için saklanır; silinmez. Firestore mode'da runtime zorunlu değildir.
DATABASE_URL=
