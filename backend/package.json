{
  "name": "zirve-ahsap-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zirve Ahşap Maliyet ve Fiyatlandırma Sistemi API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes --config ../firebase.json",
    "firestore:migrate": "ts-node --transpile-only -r dotenv/config scripts/migrate-postgres-to-firestore.ts",
    "firestore:inspect": "ts-node --transpile-only -r dotenv/config scripts/inspect-firestore-collections.ts",
    "firestore:unique-guards": "ts-node --transpile-only -r dotenv/config scripts/backfill-firestore-unique-guards.ts",
    "firestore:verify-invariants": "ts-node --transpile-only -r dotenv/config scripts/verify-firestore-invariants.ts",
    "firestore:compare": "ts-node --transpile-only -r dotenv/config scripts/compare-postgres-firestore.ts",
    "firestore:shadow": "ts-node --transpile-only -r dotenv/config scripts/shadow-compare-calculators.ts",
    "firestore:backup-pre-cutover": "ts-node --transpile-only -r dotenv/config scripts/backup-pg-pre-cutover.ts",
    "firestore:write-acceptance": "ts-node --transpile-only -r dotenv/config scripts/firestore-write-acceptance.ts",
    "firestore:cutover": "ts-node --transpile-only -r dotenv/config scripts/apply-cutover.ts",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.1",
    "jest": "^29.7.0",
    "prisma": "^6.16.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
