DATABASE_URL=postgresql://zirve:zirve_dev@localhost:5432/zirve_ahsap
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Production: FRONTEND_ORIGINS=https://zirve-ahsap.web.app,https://maliyet.zirveahsap.com
# CORS `*` yok.
NODE_ENV=development

# Firestore (Admin SDK). React istemcisi Firestore'a bağlanmaz.
# Boş bırakılırsa PostgreSQL/Prisma tek kaynak olarak çalışır.
DATA_STORE=postgres
FIREBASE_PROJECT_ID=zirve-ahsap
FIREBASE_REQUIRED=false
FIREBASE_USE_ADC=false
# Local: GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Production / Cloud Run: FIREBASE_USE_ADC=true (JSON dosyası deploy etme)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=zirve-ahsap.firebaseapp.com
FIREBASE_STORAGE_BUCKET=zirve-ahsap.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
