generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ham madde ALIŞ fiyatı tipi. Ürün SATIŞ kanalı için ayrı bir enum kullanılacaktır.
enum MaterialPriceType {
  CASH             // Peşin alış fiyatı
  CARD_INSTALLMENT // Kredi kartı / taksitli alış fiyatı
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Pervaz kılçık NET kaynağı. Excel master, STANDARD/WIDE üretim tipi değildir.
enum PervazKilcikYieldSource {
  EXCEL_MASTER
  MANUAL_VERIFIED
}

/// Ürün grubu (ör. door_frame). Hesaplama stratejisi gruba bağlıdır; her grup recipe kullanmak zorunda değildir.
model ProductGroup {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products        Product[]
  extraCostValues ExtraCostValue[]
  pricingSettings PricingSetting[]

  @@map("product_groups")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  productGroupId String   @map("product_group_id") @db.Uuid
  code           String
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productGroup    ProductGroup     @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  recipes         Recipe[]
  extraCostValues ExtraCostValue[]
  pricingSettings PricingSetting[]
  priceOverrides     PriceOverride[]
  productionYields   ProductionYield[]
  pervazKilcikYields PervazKilcikYield[]
  pricingRowExceptions PricingRowException[]

  @@unique([productGroupId, code])
  @@map("products")
}

/// Ürün/parça EN × BOY. Canonical birim MM. Tabaka kalınlığı (thickness_mm) ile karıştırılmaz.
model ProductSize {
  id          String   @id @default(uuid()) @db.Uuid
  widthMm     Int      @map("width_mm")
  lengthMm    Int      @map("length_mm")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipes        Recipe[]
  priceOverrides PriceOverride[]

  @@unique([widthMm, lengthMm])
  @@map("product_sizes")
}

/// Ham madde kimliği. Fiyat bu tabloda tutulmaz; raw_material_prices'a bakılır.
model RawMaterial {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  /// MDF kalınlığı (mm). 2.7 gibi ondalık değerler desteklenir; parça EN/BOY ile karıştırılmaz.
  thicknessMm   Decimal  @map("thickness_mm") @db.Decimal(8, 2)
  sheetWidthMm  Int      @map("sheet_width_mm")
  sheetLengthMm Int      @map("sheet_length_mm")
  surfaceType   String?  @map("surface_type")
  supplierName  String?  @map("supplier_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  prices           RawMaterialPrice[]
  productionYields ProductionYield[]
  recipeItems      RecipeItem[]
  pervazKilcikYields PervazKilcikYield[]

  @@map("raw_materials")
}

/// Ham madde alış fiyatı geçmişi. Audit kaydından ayrıdır.
/// CHECK ve partial-unique kısıtlamalar migration SQL'inde tanımlanır.
model RawMaterialPrice {
  id            String            @id @default(uuid()) @db.Uuid
  rawMaterialId String            @map("raw_material_id") @db.Uuid
  priceType     MaterialPriceType @map("price_type")
  price         Decimal           @db.Decimal(14, 4)
  effectiveFrom DateTime          @map("effective_from")
  effectiveTo   DateTime?         @map("effective_to")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([rawMaterialId, priceType, effectiveFrom])
  @@map("raw_material_prices")
}

/// Doğrulanmış NET adet master datası. Formülle türetilmez.
model ProductionYield {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  rawMaterialId String   @map("raw_material_id") @db.Uuid
  pieceWidthMm  Int      @map("piece_width_mm")
  pieceLengthMm Int      @map("piece_length_mm")
  netQty        Int      @map("net_qty")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  recipeItems RecipeItem[]

  /// Normal unique kaldırıldı; tekillik partial unique index ile sağlanır:
  /// Generic kayıtlar productId=null; ürün bağlamlı Excel farkları productId ile tutulur.
  /// Partial unique indexler aktif generic ve aktif product-scoped kayıtları ayrı korur.
  @@map("production_yields")
}

/// Pervaz kılçık tipi master. NET buradan türetilmez; cutPitch yalnızca teorik kesim içindir.
model KilcikType {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  nominalWidthMm    Int      @map("nominal_width_mm")
  bladeAllowanceMm  Int      @map("blade_allowance_mm")
  cutPitchMm        Int      @map("cut_pitch_mm")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  pervazKilcikYields PervazKilcikYield[]

  @@map("kilcik_types")
}

/// Pervaz kılçık NET. Excel MASTER anahtarı product + kalınlık + boydur.
/// kilcikTypeId açıkça doğrulanmış varyantta (örn. GENİŞ KILÇIK) doldurulabilir;
/// MANUAL_VERIFIED kayıtlarda zorunludur.
/// Partial unique (migration SQL):
/// - aktif EXCEL_MASTER: (product_id, pervaz_thickness_mm, piece_length_mm)
/// - aktif MANUAL_VERIFIED + kilcik_type_id: (product_id, pervaz_thickness_mm, kilcik_type_id, piece_length_mm)
model PervazKilcikYield {
  id                 String                   @id @default(uuid()) @db.Uuid
  productId          String                   @map("product_id") @db.Uuid
  pervazThicknessMm  Int                      @map("pervaz_thickness_mm")
  kilcikTypeId       String?                  @map("kilcik_type_id") @db.Uuid
  rawMaterialId      String                   @map("raw_material_id") @db.Uuid
  pieceLengthMm      Int                      @map("piece_length_mm")
  netQty             Int                      @map("net_qty")
  source             PervazKilcikYieldSource  @default(EXCEL_MASTER)
  excelCutWidthMm    Int?                     @map("excel_cut_width_mm")
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  kilcikType  KilcikType? @relation(fields: [kilcikTypeId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([productId, pervazThicknessMm, pieceLengthMm], map: "pervaz_kilcik_yields_excel_context_idx")
  @@map("pervaz_kilcik_yields")
}

model Recipe {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productSizeId String   @map("product_size_id") @db.Uuid
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize ProductSize  @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  items       RecipeItem[]

  @@unique([productId, productSizeId])
  @@map("recipes")
}

/// Genel model: item sayısı ve yield varlığı global DB kuralı değildir.
/// Kapı kasası için productionYieldId zorunluluğu ve 2-parça kuralı
/// yalnızca backend business validation'da (recipe-item.validation.ts) uygulanır.
/// Diğer ürün grupları production_yields kullanmak zorunda değildir.
model RecipeItem {
  id                String   @id @default(uuid()) @db.Uuid
  recipeId          String   @map("recipe_id") @db.Uuid
  rawMaterialId     String   @map("raw_material_id") @db.Uuid
  /// Nullable: kapı kasası dışındaki ürün grupları yield kullanmayabilir.
  /// Kapı kasası business validation'da NOT NULL kontrolü yapılır.
  productionYieldId String?  @map("production_yield_id") @db.Uuid
  quantity          Decimal  @db.Decimal(12, 4)
  sortOrder         Int      @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  rawMaterial     RawMaterial      @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  productionYield ProductionYield? @relation(fields: [productionYieldId], references: [id], onDelete: Restrict)

  @@unique([recipeId, sortOrder])
  @@map("recipe_items")
}

model ExtraCostType {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  values ExtraCostValue[]

  @@map("extra_cost_types")
}

/// Kapsam: ya productGroupId ya productId dolu olmalı; ikisi aynı anda olamaz.
/// Bu kural migration SQL'indeki CHECK ile de korunur.
model ExtraCostValue {
  id              String    @id @default(uuid()) @db.Uuid
  extraCostTypeId String    @map("extra_cost_type_id") @db.Uuid
  productGroupId  String?   @map("product_group_id") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  amount          Decimal   @db.Decimal(14, 4)
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  extraCostType ExtraCostType @relation(fields: [extraCostTypeId], references: [id], onDelete: Restrict)
  productGroup  ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([extraCostTypeId, productGroupId, productId])
  @@map("extra_cost_values")
}

/// Type-safe fiyatlandırma parametreleri. Faz 1A'da hesap motorunda kullanılmaz.
/// Kapsam: productGroupId (grup) veya productId (ürün) veya ikisi de null (global).
/// İkisi aynı anda dolu olamaz. Tekillik: migration SQL partial unique index
/// (grup / ürün / yalnızca ikisi de null olan global).
model PricingSetting {
  id             String   @id @default(uuid()) @db.Uuid
  productGroupId String?  @map("product_group_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  vatRate                  Decimal? @map("vat_rate") @db.Decimal(8, 4)
  profitRate               Decimal? @map("profit_rate") @db.Decimal(8, 4)
  /// Yüzde kart farkı (Kapı Kasası %20). Pervaz +2 TL burada tutulmaz.
  cardMarkupRate           Decimal? @map("card_markup_rate") @db.Decimal(8, 4)
  /// Sabit TL kart farkı (Pervaz Excel: nakit + 2). Kapı Kasası NULL.
  /// cardMarkupRate ile aynı kayıtta birlikte dolu olamaz.
  cardFixedSurchargeAmount Decimal? @map("card_fixed_surcharge_amount") @db.Decimal(14, 4)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productGroup ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productGroupId, productId])
  @@map("pricing_settings")
}

/// PERVAZ satır fiyatlandırması: özel kâr, dekoratif fark ve/veya ROUNDUP sonrası adjustment.
/// Mutlak satış fiyatı (PriceOverride.cashPrice) değildir. Default %15 burada tekrar yazılmaz.
/// Tekillik: migration SQL partial unique (aktif + açık dönem).
model PricingRowException {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  thicknessMm       Int       @map("thickness_mm")
  widthMm           Int       @map("width_mm")
  lengthMm          Int       @map("length_mm")
  profitRate            Decimal? @map("profit_rate") @db.Decimal(8, 4)
  decorativePremiumRate Decimal? @map("decorative_premium_rate") @db.Decimal(8, 4)
  adjustmentAmount      Decimal? @map("adjustment_amount") @db.Decimal(14, 4)
  /// TRUE: bu satır için kart fiyatı Excel’de doğrulanmış. NULL: default / doğrulanmamış.
  /// FALSE: açıkça kart gösterme. AYARLI kart yayını yalnız TRUE kabul eder.
  cardSaleEnabled       Boolean? @map("card_sale_enabled")
  isActive          Boolean   @default(true) @map("is_active")
  effectiveFrom     DateTime  @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, thicknessMm, widthMm, lengthMm], map: "pricing_row_exceptions_row_idx")
  @@map("pricing_row_exceptions")
}

/// Ticari nakit fiyat override. Hesaplanan (calculated) fiyatı değiştirmez.
/// Aynı product + productSize için yalnızca tek aktif kayıt (partial unique, SQL).
/// Eski kayıt isActive=false ile korunur; overwrite yok.
model PriceOverride {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productSizeId String   @map("product_size_id") @db.Uuid
  cashPrice     Decimal  @map("cash_price") @db.Decimal(14, 4)
  reason        String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Restrict)

  @@index([productId, productSizeId])
  @@map("price_overrides")
}

/// Append-only değişiklik izi. Fiyat geçmişi raw_material_prices üzerindedir.
/// fieldName nullable: CREATE/DELETE olaylarında alan adı zorunlu değildir.
model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  fieldName  String?     @map("field_name")
  oldValue   String?     @map("old_value")
  newValue   String?     @map("new_value")
  reason     String?
  actor      String      @default("local-admin")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}
