rules_version = '2';

/**
 * Production: deny-by-default.
 * Maliyet, master data, sipariş ve audit istemciden okunamaz/yazılamaz.
 * NestJS Firebase Admin SDK bu kuralları bypass eder.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
